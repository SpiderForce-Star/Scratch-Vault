# Stripe (Sandbox / Test keys for development)
# Production (Vercel Production only): sk_live_ / pk_live_ / live price IDs / live whsec_
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Local/dev: sandbox prices. Production must set live price IDs — checkout
# refuses missing env vars and refuses sandbox IDs when using sk_live_ keys.
#   monthly price_1U5t25RpUVJitDggbykPkMzh
#   annual  price_1U5t25RpUVJitDggtSQ4Qfws
STRIPE_PRICE_MONTHLY=price_1U4uLH2OSSYBR9Vqdc9ZrFN2
STRIPE_PRICE_ANNUAL=price_1U4uLH2OSSYBR9VqEfITU1IV
# Dashboard endpoint: https://volunteer-scratch-vault.vercel.app/api/stripe/webhook
# Stripe product names (Dashboard): "Scratch Vault Full Access" monthly / annual.
# Events: checkout.session.completed, customer.subscription.created,
#         customer.subscription.updated, customer.subscription.deleted,
#         invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...
# Set to 1 after Stripe Tax registrations are in place. Leave unset until then.
# STRIPE_AUTOMATIC_TAX=1

# Optional extra checkout hosts (comma-separated). Production host is always allowed.
# ALLOWED_CHECKOUT_HOSTS=www.example.com

# Daily remaining-prize cron (GET /api/cron/daily-fetch at 15 11 * * * / 06:15 CT).
# Vercel Cron sends x-vercel-cron: 1. Bearer CRON_SECRET also authorized.
# CRON_SECRET=

# Existing auth / DB vars stay the same

# Native live-reload only (never set on store / EAS production builds)
# CAP_LIVE_RELOAD=1
# CAP_DEV_URL=http://192.168.1.10:8080

# RevenueCat public SDK keys (safe in the client). Never commit secret API keys.
# VITE_REVENUECAT_APPLE_API_KEY=appl_...
# VITE_REVENUECAT_GOOGLE_API_KEY=goog_...

# Server-only RevenueCat secret — needed so native IAP subscribers can load
# mid-tier remaining counts from the desk API. Never prefix with VITE_.
# REVENUECAT_SECRET_API_KEY=sk_...
